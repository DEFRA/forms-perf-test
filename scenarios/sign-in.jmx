        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TEST check that the test secret is set" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Without the secret, each read of a code gets a 401 and the run measures
// nothing. Stop here so that the cause is clear.
def secret = System.getenv('OTP_TEST_READ_SECRET')

if (secret == null || secret.isEmpty()) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseMessage('OTP_TEST_READ_SECRET is not set')
  SampleResult.setStopTestNow(true)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
