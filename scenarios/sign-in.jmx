<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Sign in">
      <stringProp name="TestPlan.comments">Signs in through forms-runner and the OIDC provider (forms-identity-ui and forms-identity-api). Each thread is one test account. forms-identity-api and this test suite must have the same OTP_TEST_READ_SECRET.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Settings" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="runnerBase" elementType="Argument">
            <stringProp name="Argument.name">runnerBase</stringProp>
            <stringProp name="Argument.value">${__P(runnerBase,https://forms-runner.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
            <stringProp name="Argument.desc">forms-runner, the OIDC client</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="identityUiBase" elementType="Argument">
            <stringProp name="Argument.name">identityUiBase</stringProp>
            <stringProp name="Argument.value">${__P(identityUiBase,https://forms-identity-ui.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
            <stringProp name="Argument.desc">forms-identity-ui, the OIDC provider</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="identityApiBase" elementType="Argument">
            <stringProp name="Argument.name">identityApiBase</stringProp>
            <stringProp name="Argument.value">${__P(identityApiBase,https://forms-identity-api.${__P(env)}.cdp-int.defra.cloud)}</stringProp>
            <stringProp name="Argument.desc">forms-identity-api, for the test code read route</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="formSlug" elementType="Argument">
            <stringProp name="Argument.name">formSlug</stringProp>
            <stringProp name="Argument.value">${__P(formSlug,jn-perf-test-v2)}</stringProp>
            <stringProp name="Argument.desc">A live form. Its homepage is the page to return to after sign-in</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="emailDomain" elementType="Argument">
            <stringProp name="Argument.name">emailDomain</stringProp>
            <stringProp name="Argument.value">example.forms.defra.gov.uk</stringProp>
            <stringProp name="Argument.desc">The test email domain that forms-identity-api accepts</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="phone" elementType="Argument">
            <stringProp name="Argument.name">phone</stringProp>
            <stringProp name="Argument.value">${__P(phone,07700900000)}</stringProp>
            <stringProp name="Argument.desc">Mobile number given when a test account is created. No message is sent to it. 07700 900000 is in the range that Ofcom reserves for fiction (07700 900000 to 900999), so it cannot belong to a real person. The identity services must accept this range for a test account</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="otpReadSecret" elementType="Argument">
            <stringProp name="Argument.name">otpReadSecret</stringProp>
            <stringProp name="Argument.value">${__groovy(System.getenv(&quot;OTP_TEST_READ_SECRET&quot;))}</stringProp>
            <stringProp name="Argument.desc">Read from the environment, so that the secret is in no file</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="thinkTimeMs" elementType="Argument">
            <stringProp name="Argument.name">thinkTimeMs</stringProp>
            <stringProp name="Argument.value">${__P(thinkTimeMs,5000)}</stringProp>
            <stringProp name="Argument.desc">Wait before each form is sent</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nextUrl" elementType="Argument">
            <stringProp name="Argument.name">nextUrl</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.desc">Set by the Next redirect script</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="hops" elementType="Argument">
            <stringProp name="Argument.name">hops</stringProp>
            <stringProp name="Argument.value">0</stringProp>
            <stringProp name="Argument.desc">Set by the Next redirect script</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="atPhonePage" elementType="Argument">
            <stringProp name="Argument.name">atPhonePage</stringProp>
            <stringProp name="Argument.value">false</stringProp>
            <stringProp name="Argument.desc">Set by the Next redirect script</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
