          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Follow each redirect" enabled="true">
            <stringProp name="WhileController.condition">${__jexl3(vars.get(&quot;nextUrl&quot;) != &quot;&quot;)}</stringProp>
          </WhileController>
