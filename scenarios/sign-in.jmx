          </ResponseAssertion>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="code" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">code</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.code</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Enter the code and return to the runner" enabled="true"/>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Next redirect" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// Finds where the response sends the browser next, so that each redirect is
// its own sample and the report shows the time for each service.
// JMeter replaces dollar-brace text in a script, so this script uses none.
def location = prev.getResponseHeaders().readLines().find {
  it.toLowerCase().startsWith('location:')
}
def hops = (vars.get('hops') ?: '0') as int
def isRedirect = prev.getResponseCode().startsWith('3') &amp;&amp; location != null

if (isRedirect &amp;&amp; hops &lt; 15) {
  def next = new URL(prev.getURL(), location.substring('location:'.length()).trim())
  def runnerHost = new URL(vars.get('runnerBase')).getHost()
  def service = next.getHost() == runnerHost ? 'runner' : 'identity-ui'
  // The provider puts a uid in its paths, and the uid is different in each
  // sign-in. A fixed label keeps one report row for each step.
  def path = service == 'identity-ui'
    ? next.getPath().replaceAll('^/(auth|interaction)/[^/]+', '/$1/{uid}')
    : next.getPath()

  vars.put('nextUrl', next.toString())
  vars.put('nextLabel', 'GET ' + service + ' ' + path)
  vars.put('hops', String.valueOf(hops + 1))
} else {
  vars.put('nextUrl', '')
  vars.put('hops', '0')
  vars.put('atPhonePage', String.valueOf(prev.getURL().getPath().endsWith('/phone')))
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Sign-in ends on the return page" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// A sign-in must end on the runner page that was asked for. A new account
// stops one time at the phone page on the way. When the phone number is
// refused, the phone page comes back as the answer to the POST, and that
// is a failure.
def code = prev.getResponseCode()

if (code.startsWith('3')) {
  return
}

def url = prev.getURL()
def runnerHost = new URL(vars.get('runnerBase')).getHost()
def atReturnPage = url.getHost() == runnerHost &amp;&amp; url.getPath().startsWith('/homepage/')
def atPhonePage = url.getPath().endsWith('/phone') &amp;&amp; prev.getHTTPMethod() == 'GET'

if (code != '200' || !(atReturnPage || atPhonePage)) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Sign-in stopped at ' + url + ' with status ' + code)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST identity-ui /interaction/{uid}/code" enabled="true">
            <stringProp name="HTTPSampler.path">${identityUiBase}/interaction/${uid}/code</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
                <elementProp name="crumb" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.value">${crumb}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">crumb</stringProp>
